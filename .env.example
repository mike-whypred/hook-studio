# Set automatically when you add the Neon integration on Vercel
DATABASE_URL=
NEON_AUTH_BASE_URL=

# Add these yourself (vercel env add NAME production)
NEON_AUTH_COOKIE_SECRET=   # any long random string: openssl rand -base64 32
ANTHROPIC_API_KEY=         # from platform.claude.com > API keys
STRIPE_SECRET_KEY=         # Stripe > Developers > API keys
STRIPE_PRICE_ID=           # price_... of your monthly plan
STRIPE_WEBHOOK_SECRET=     # whsec_... from the webhook endpoint you create

# Optional
ANTHROPIC_MODEL=claude-opus-5-5
DAILY_AI_LIMIT=300
PLAN_PRICE_LABEL=$19
APP_URL=                   # e.g. https://your-domain.com (defaults to the request's domain)
